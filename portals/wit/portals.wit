/// Portals: the only things a Grind OS driver can import.
///
/// A driver is instantiated against exactly one device. Portals are bound to
/// that device by the host, so there is no way to name another device, and
/// no host pointers, file descriptors or PCI config space ever reach the
/// driver.
package grind:portals@0.1.0;

/// The device's register window: the memory BAR that holds its registers
/// (BAR0 for most devices, BAR1 for the RTL8139). Other BARs, I/O-port
/// windows, the MSI-X table and config space are never exposed: some of
/// them reach registers indirectly and would bypass the write list.
///
/// Accesses are 8, 16 or 32 bits wide and naturally aligned. A write is
/// checked against every byte it touches, so a 32-bit write that covers a
/// denied byte register is denied.
interface mmio {
    enum error {
        /// The access does not fit inside the window.
        out-of-range,
        /// The offset is not a multiple of the access width.
        misaligned,
        /// The register is on the device's deny list (rule 10). The attempt
        /// is logged and the run counts as a failure even if the driver
        /// handles this error.
        denied,
    }

    /// Size of the window in bytes.
    size: func() -> u32;
    read8: func(offset: u32) -> result<u8, error>;
    read16: func(offset: u32) -> result<u16, error>;
    read32: func(offset: u32) -> result<u32, error>;
    write8: func(offset: u32, value: u8) -> result<_, error>;
    write16: func(offset: u32, value: u16) -> result<_, error>;
    write32: func(offset: u32, value: u32) -> result<_, error>;
}

/// Memory the device can reach by DMA. The host pins it and maps it into the
/// device's IOMMU domain; the device cannot reach any other memory.
interface dma {
    enum error {
        /// Size is zero or larger than one allocation may be.
        bad-size,
        /// The driver's total DMA allowance is used up.
        out-of-memory,
        /// The access does not fit inside the buffer.
        out-of-range,
    }

    resource buffer {
        /// The address the device uses for this buffer. Put this in
        /// descriptors; it is not a host address.
        iova: func() -> u64;
        /// Size in bytes (the requested size rounded up to 4096).
        size: func() -> u32;
        read: func(offset: u32, len: u32) -> result<list<u8>, error>;
        write: func(offset: u32, data: list<u8>) -> result<_, error>;
    }

    /// Allocate a zeroed, 4096-byte-aligned buffer.
    allocate: func(size: u32) -> result<buffer, error>;

    /// Like `allocate`, but the whole buffer lies below 4 GiB (IOVA +
    /// size <= 2^32), for devices that can only address 32 bits. Returns
    /// `out-of-memory` if the IOMMU leaves no usable addresses there.
    allocate32: func(size: u32) -> result<buffer, error>;
}

interface clock {
    /// Monotonic time in nanoseconds since an arbitrary start.
    now-ns: func() -> u64;
    /// Sleep for at least this many microseconds (capped at one second per
    /// call). Time spent sleeping counts toward the driver's time limit.
    sleep-us: func(us: u32);
}

interface log {
    enum level { debug, info, warn, error }

    /// One structured log entry: what was attempted, what was expected and
    /// what happened belong in `fields`.
    emit: func(level: level, message: string, fields: list<tuple<string, string>>);
}

/// A driver: imports only portals.
world driver {
    import mmio;
    import dma;
    import clock;
    import log;

    /// Bring the device up. An error string says what went wrong.
    export start: func() -> result<_, string>;
}

/// The packet-facing side of an Ethernet driver. The driver exports it; the
/// host calls it only after `start` returned ok, and never concurrently.
/// There are no interrupts: the host polls `receive`.
///
/// Frames run from the destination MAC address through the payload: no
/// preamble and no FCS. The host does not pad short frames.
///
/// Robustness contract (docs/design/robust-nic.md). The NIC test forces
/// each of these conditions in every run, and a driver's SPEC.md says how
/// it meets each:
///
/// - Link goes down: `link-up` returns false within 1 s; `transmit` may
///   return an error or drop the frame. Link comes back: `link-up` true and
///   frames flow again within 5 s, without `start` being called again.
/// - Frames arrive faster than the host polls: frames may be lost, but the
///   driver recovers by itself and frames flow again within 1 s of the
///   flood ending.
/// - Hostile frames (oversized, runt, garbage) are never returned if
///   outside 14-1514 bytes and never break later receives.
/// - A full transmit ring makes `transmit` return an error; nothing blocks
///   past the call limit.
/// - Registers reading all-ones (a device gone or wedged): every call
///   returns within the limit, with a readable error if it cannot do its
///   job; the driver recovers if the device comes back.
/// - Anything the device writes to DMA memory (descriptor lengths, status,
///   indexes, headers) is validated before use: a bad value means a
///   readable error or a dropped frame, never an out-of-range access, a
///   trap, or a wrong frame returned.
/// - DMA allocation failing makes `start` return a readable error.
/// - Over a run: no trap, no timeout, no growth in DMA memory after
///   `start`, and every error string non-empty, saying what was attempted,
///   expected and got (rule 3).
///
/// An error is not a failure in itself: reporting "link down" is correct.
interface ethernet {
    /// The station address the device receives unicast frames for.
    mac-address: func() -> tuple<u8, u8, u8, u8, u8, u8>;
    /// Whether the link is up now (as the device reports it).
    link-up: func() -> bool;
    /// Send one frame (14 to 1514 bytes). Returning ok means the frame was
    /// handed to the device, not that it has left the wire. An error when
    /// the frame cannot be queued (link down, ring full).
    transmit: func(frame: list<u8>) -> result<_, string>;
    /// Take one received frame, if any is waiting. An error only when the
    /// driver cannot tell (the device misbehaving); the next call tries
    /// again.
    receive: func() -> result<option<list<u8>>, string>;
}

/// An Ethernet (NIC) driver: the driver world plus the ethernet exports.
world nic {
    include driver;
    export ethernet;
}

/// NVMe commands, submitted through the shim (CLAUDE.md rule 10). Linked
/// only when the device under test is an NVMe controller.
///
/// The shim owns the controller's configuration and every queue: the admin
/// queue and all I/O submission and completion queues, in the shim's own
/// memory, with their doorbells. A driver hands it 64-byte commands; the
/// shim checks each one against the device's command allow list and the
/// driver's own DMA buffers, copies it into its own queue, and rings the
/// doorbell. Completions come back through `complete`. Because the shim
/// reads every completion itself, it knows how far the device has fetched
/// each submission queue and never overwrites an entry the device may
/// still be reading.
interface nvme {
    enum error {
        /// The shim refused the command (rule 10). The refusal is logged
        /// and the run counts as a failure even if the driver handles this
        /// error.
        refused,
        /// No I/O queue with this ID exists.
        unknown-queue,
        /// The submission queue is full: collect completions with
        /// `complete` to free entries.
        queue-full,
        /// The admin command did not complete in time. The admin queue is
        /// no longer usable in this run.
        timeout,
        /// The controller or the admin queue failed earlier in this run;
        /// already logged.
        failed,
    }

    /// Run one admin command and wait for it. Returns the 16-byte
    /// completion queue entry, with the driver's command identifier.
    /// Create I/O Completion Queue and Create I/O Submission Queue must
    /// have PRP1 = 0: the shim allocates every queue.
    admin: func(command: list<u8>) -> result<list<u8>, error>;

    /// Queue one I/O command on submission queue `sqid`. Its completion is
    /// returned by `complete` for the completion queue the submission queue
    /// was created with.
    submit: func(sqid: u16, command: list<u8>) -> result<_, error>;

    /// Take the completions waiting in I/O completion queue `cqid`, oldest
    /// first: each a 16-byte entry as the device wrote it. Empty if none
    /// are waiting. Does not wait.
    complete: func(cqid: u16) -> result<list<list<u8>>, error>;
}

/// An NVMe driver: the driver world plus the nvme portal.
world nvme-driver {
    include driver;
    import nvme;
}

/// The block-facing side of a storage driver. The driver exports it; the
/// host calls it only after `start` returned ok, and never concurrently.
///
/// Every error string says what was attempted, what was expected and what
/// happened (rule 3). After returning an error, the driver keeps working.
interface block {
    /// Bytes per logical block.
    block-size: func() -> u32;
    /// Number of logical blocks.
    capacity: func() -> u64;
    /// Read `count` blocks starting at `lba`. An error, reading nothing, if
    /// `count` is 0 or the range does not fit inside `capacity` (including
    /// when `lba + count` overflows).
    read: func(lba: u64, count: u32) -> result<list<u8>, string>;
    /// Write whole blocks starting at `lba`. An error, writing nothing at
    /// all, if `data` is empty, is not a whole number of blocks, or the
    /// range does not fit inside `capacity`: a write that runs past the end
    /// must not leave the blocks that fit written.
    write: func(lba: u64, data: list<u8>) -> result<_, string>;
    /// Make every completed write durable.
    flush: func() -> result<_, string>;
}

/// A block driver for an NVMe controller.
world block-driver {
    include nvme-driver;
    export block;
}
